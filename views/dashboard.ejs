<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Nexus Admin</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <script src="/socket.io/socket.io.js"></script>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                fontFamily: { sans: ['Inter', 'sans-serif'] },
                extend: {
                    colors: {
                        slate: { 850: '#151e2e', 900: '#0f172a' },
                        primary: { 500: '#3b82f6', 600: '#2563eb' }
                    }
                }
            }
        }
    </script>

    <style>
        /* Smooth Scrolling */
        html { scroll-behavior: smooth; }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 10px; }
        
        /* Modal Animation */
        .modal-enter { opacity: 0; transform: scale(0.95); }
        .modal-enter-active { opacity: 1; transform: scale(1); transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1); }
        .modal-exit { opacity: 0; transform: scale(0.95); transition: all 0.2s ease-in; }

        /* Mobile Bottom Nav Fix */
        .pb-safe { padding-bottom: env(safe-area-inset-bottom); }
    </style>
</head>
<body class="bg-slate-900 text-slate-400 font-sans selection:bg-blue-500/30 selection:text-blue-200">

    <div class="flex h-screen overflow-hidden">

        <nav class="md:hidden fixed bottom-0 left-0 w-full bg-slate-850/90 backdrop-blur-lg border-t border-slate-700/50 z-50 pb-safe">
            <div class="flex justify-around items-center h-16 px-2">
                <a href="#" class="flex flex-col items-center justify-center w-full h-full text-blue-500">
                    <i class="ph-fill ph-squares-four text-xl mb-1"></i>
                    <span class="text-[10px] font-medium">Home</span>
                </a>
                <a href="#" class="flex flex-col items-center justify-center w-full h-full text-slate-500 hover:text-slate-300">
                    <i class="ph ph-users text-xl mb-1"></i>
                    <span class="text-[10px] font-medium">Users</span>
                </a>
                <div class="relative -top-5">
                    <button onclick="toggleModal()" class="w-12 h-12 rounded-full bg-blue-600 text-white shadow-lg shadow-blue-600/30 flex items-center justify-center">
                        <i class="ph-bold ph-plus"></i>
                    </button>
                </div>
                <a href="#" class="flex flex-col items-center justify-center w-full h-full text-slate-500 hover:text-slate-300">
                    <i class="ph ph-chart-line-up text-xl mb-1"></i>
                    <span class="text-[10px] font-medium">Stats</span>
                </a>
                <a href="#" class="flex flex-col items-center justify-center w-full h-full text-slate-500 hover:text-slate-300">
                    <i class="ph ph-gear text-xl mb-1"></i>
                    <span class="text-[10px] font-medium">Settings</span>
                </a>
            </div>
        </nav>

        <aside class="hidden md:flex w-64 flex-col bg-slate-850 border-r border-slate-800 z-40">
            <div class="h-16 flex items-center px-6 border-b border-slate-800/50">
                <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white mr-3 shadow-lg shadow-blue-900/20">
                    <i class="ph-bold ph-robot"></i>
                </div>
                <span class="text-white font-bold text-lg tracking-tight">Nexus</span>
            </div>

            <nav class="flex-1 p-4 space-y-1">
                <a href="#" class="flex items-center gap-3 px-4 py-3 bg-blue-600/10 text-blue-400 rounded-xl font-medium border border-blue-600/10">
                    <i class="ph-fill ph-squares-four text-lg"></i> Dashboard
                </a>
                <a href="#" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:bg-slate-800 hover:text-slate-100 rounded-xl font-medium transition-colors">
                    <i class="ph ph-users text-lg"></i> Users
                </a>
                <a href="#" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:bg-slate-800 hover:text-slate-100 rounded-xl font-medium transition-colors">
                    <i class="ph ph-chart-line-up text-lg"></i> Analytics
                </a>
                <a href="#" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:bg-slate-800 hover:text-slate-100 rounded-xl font-medium transition-colors">
                    <i class="ph ph-gear text-lg"></i> Settings
                </a>
            </nav>

            <div class="p-4 border-t border-slate-800/50">
                <button onclick="toggleModal()" class="flex items-center gap-3 w-full p-2 rounded-xl hover:bg-slate-800 transition-colors text-left group">
                    <div class="relative">
                        <img src="https://ui-avatars.com/api/?name=Admin&background=0ea5e9&color=fff" class="w-9 h-9 rounded-full ring-2 ring-slate-900 group-hover:ring-blue-500 transition-all" alt="Admin">
                        <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-green-500 border-2 border-slate-850 rounded-full"></span>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-white group-hover:text-blue-400 transition-colors">Admin User</p>
                        <p class="text-xs text-slate-500">View Profile</p>
                    </div>
                </button>
            </div>
        </aside>

        <main class="flex-1 flex flex-col relative overflow-hidden h-full">
            
            <header class="md:hidden h-16 flex items-center justify-between px-4 bg-slate-900/80 backdrop-blur-md sticky top-0 z-30 border-b border-slate-800/50">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white">
                        <i class="ph-bold ph-robot"></i>
                    </div>
                    <span class="text-white font-bold text-lg">Nexus</span>
                </div>
                <button onclick="toggleModal()" class="relative">
                    <img src="https://ui-avatars.com/api/?name=Admin&background=0ea5e9&color=fff" class="w-8 h-8 rounded-full" alt="Profile">
                    <span class="absolute top-0 right-0 w-2.5 h-2.5 bg-red-500 rounded-full border-2 border-slate-900"></span>
                </button>
            </header>

            <div class="flex-1 overflow-y-auto p-4 md:p-8 pb-24 md:pb-8 space-y-6">
                
                <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
                    <div>
                        <h2 class="text-2xl font-bold text-white tracking-tight">Overview</h2>
                        <p class="text-sm text-slate-500 mt-1">Real-time performance metrics</p>
                    </div>
                    <div class="flex items-center gap-2 text-xs font-medium bg-slate-800/50 px-3 py-1.5 rounded-full border border-slate-700/50">
                        <span class="relative flex h-2 w-2">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                        </span>
                        <span class="text-emerald-400">System Online</span>
                    </div>
                </div>

                <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-6">
                    <div class="bg-slate-850 p-4 md:p-5 rounded-2xl border border-slate-800 shadow-sm relative overflow-hidden group">
                        <div class="absolute right-0 top-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                            <i class="ph-fill ph-download-simple text-6xl text-blue-500"></i>
                        </div>
                        <p class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-1">Downloads</p>
                        <h3 id="stat-downloads" class="text-2xl md:text-3xl font-bold text-white"><%= stats.downloads %></h3>
                        <div class="mt-2 text-xs text-blue-400 font-medium flex items-center gap-1">
                            <i class="ph-bold ph-trend-up"></i> +12% this week
                        </div>
                    </div>

                    <div class="bg-slate-850 p-4 md:p-5 rounded-2xl border border-slate-800 shadow-sm">
                        <p class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-1">Total Users</p>
                        <h3 id="stat-total-users" class="text-2xl md:text-3xl font-bold text-white"><%= stats.total_users %></h3>
                    </div>

                    <div class="bg-slate-850 p-4 md:p-5 rounded-2xl border border-slate-800 shadow-sm ring-1 ring-emerald-500/20">
                        <p class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-1 flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Active
                        </p>
                        <h3 id="stat-active" class="text-2xl md:text-3xl font-bold text-emerald-400"><%= stats.active_now %></h3>
                    </div>

                    <div class="bg-slate-850 p-4 md:p-5 rounded-2xl border border-slate-800 shadow-sm">
                        <p class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-1">Uptime</p>
                        <h3 class="text-2xl md:text-3xl font-bold text-white">
                            <%= Math.floor(uptime / 60) %><span class="text-sm text-slate-500 font-medium ml-1">min</span>
                        </h3>
                    </div>
                </div>

                <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
                    <div class="xl:col-span-2 bg-slate-850 rounded-2xl border border-slate-800 p-5 md:p-6">
                        <div class="flex items-center justify-between mb-6">
                            <h3 class="font-semibold text-white">Growth Analytics</h3>
                            <button class="text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 px-3 py-1.5 rounded-lg transition-colors">
                                Last 7 Days
                            </button>
                        </div>
                        <div class="h-64 w-full">
                            <canvas id="growthChart"></canvas>
                        </div>
                    </div>

                    <div class="bg-slate-850 rounded-2xl border border-slate-800 flex flex-col h-80 xl:h-auto overflow-hidden">
                        <div class="p-4 border-b border-slate-800 bg-slate-800/30 flex justify-between items-center">
                            <h3 class="font-semibold text-white text-sm">Live Sessions</h3>
                            <div class="flex -space-x-1">
                                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                            </div>
                        </div>
                        <div id="live-user-list" class="flex-1 overflow-y-auto p-2 space-y-1 scrollbar-thin">
                            <% if(users.length === 0) { %>
                                <div class="h-full flex flex-col items-center justify-center text-slate-600">
                                    <i class="ph-duotone ph-plugs text-3xl mb-2"></i>
                                    <p class="text-xs">No active sessions</p>
                                </div>
                            <% } else { %>
                                <% users.forEach(user => { %>
                                    <div class="flex items-center justify-between p-3 rounded-lg bg-slate-900/50 border border-slate-800/50">
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-xs font-bold text-slate-300 border border-slate-700">
                                                <%= user.name.charAt(0) %>
                                            </div>
                                            <div>
                                                <p class="text-xs font-medium text-white"><%= user.name %></p>
                                                <p class="text-[10px] text-slate-500">ID: ...<%= user.id.toString().slice(-4) %></p>
                                            </div>
                                        </div>
                                        <span class="text-[10px] font-mono text-emerald-500 bg-emerald-500/10 px-2 py-0.5 rounded">ONLINE</span>
                                    </div>
                                <% }); %>
                            <% } %>
                        </div>
                    </div>
                </div>

                <div class="bg-slate-850 rounded-2xl border border-slate-800 overflow-hidden">
                    <div class="px-6 py-4 border-b border-slate-800 flex justify-between items-center">
                        <h3 class="font-semibold text-white text-sm">Recent Users</h3>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead class="bg-slate-900/50 text-xs uppercase text-slate-500 font-medium">
                                <tr>
                                    <th class="px-6 py-3">User</th>
                                    <th class="px-6 py-3">Joined</th>
                                    <th class="px-6 py-3">Usage</th>
                                    <th class="px-6 py-3 text-right">Last Seen</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-800 text-sm">
                                <% dbUsers.forEach(u => { 
                                    const percentage = Math.min(u.downloads * 2, 100) + '%'; 
                                %>
                                <tr class="hover:bg-slate-800/50 transition-colors">
                                    <td class="px-6 py-3">
                                        <div class="flex items-center gap-3">
                                            <img src="https://ui-avatars.com/api/?name=<%= u.firstName %>&background=0f172a&color=cbd5e1&size=32" class="w-8 h-8 rounded-full" alt="">
                                            <span class="text-slate-300 font-medium"><%= u.firstName %></span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-3 text-slate-500 text-xs">
                                        <%= u.joinedAt.toLocaleDateString() %>
                                    </td>
                                    <td class="px-6 py-3">
                                        <div class="flex items-center gap-2">
                                            <div class="w-16 h-1.5 bg-slate-800 rounded-full overflow-hidden">
                                                
                                            </div>
                                            <span class="text-xs text-slate-400 font-mono"><%= u.downloads %></span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-3 text-right text-slate-500 text-xs font-mono">
                                        <%= new Date(u.lastActive).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <div id="profileModal" class="fixed inset-0 z-[60] hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm transition-opacity opacity-0" id="modalBackdrop"></div>

        <div class="fixed inset-0 z-10 overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                <div class="relative transform overflow-hidden rounded-2xl bg-slate-850 border border-slate-700 text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-sm opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" id="modalPanel">
                    
                    <div class="bg-gradient-to-r from-blue-600 to-indigo-600 h-24 relative">
                        <button onclick="toggleModal()" class="absolute top-3 right-3 text-white/70 hover:text-white bg-black/20 hover:bg-black/40 rounded-full p-1 transition-colors">
                            <i class="ph ph-x text-lg"></i>
                        </button>
                    </div>
                    
                    <div class="px-6 pb-6 relative">
                        <div class="-mt-12 mb-4">
                            <img class="h-24 w-24 rounded-full border-4 border-slate-850 shadow-lg" src="https://ui-avatars.com/api/?name=Admin&background=0ea5e9&color=fff&size=128" alt="Admin">
                        </div>
                        
                        <div class="text-center sm:text-left">
                            <h3 class="text-xl font-bold leading-6 text-white" id="modal-title">Admin Controller</h3>
                            <p class="text-sm text-slate-400 mt-1">Super Administrator</p>
                            
                            <div class="mt-4 flex flex-col gap-2">
                                <div class="flex justify-between items-center p-3 bg-slate-800 rounded-lg border border-slate-700">
                                    <span class="text-sm text-slate-300">Status</span>
                                    <span class="flex items-center gap-1.5 text-xs font-medium text-emerald-400 bg-emerald-400/10 px-2 py-0.5 rounded-full border border-emerald-400/20">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Online
                                    </span>
                                </div>
                                <div class="flex justify-between items-center p-3 bg-slate-800 rounded-lg border border-slate-700">
                                    <span class="text-sm text-slate-300">Server ID</span>
                                    <span class="text-xs font-mono text-slate-500">SRV-001-HK</span>
                                </div>
                            </div>

                            <div class="mt-6 grid grid-cols-2 gap-3">
                                <button type="button" class="inline-flex w-full justify-center rounded-lg bg-slate-800 px-3 py-2 text-sm font-semibold text-white shadow-sm ring-1 ring-inset ring-slate-700 hover:bg-slate-700">Settings</button>
                                <button type="button" class="inline-flex w-full justify-center rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">Edit Profile</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // --- 📊 CHART SETUP ---
        const ctx = document.getElementById('growthChart').getContext('2d');
        const labels = JSON.parse('<%- JSON.stringify(chartData.labels) %>');
        const dataValues = JSON.parse('<%- JSON.stringify(chartData.values) %>');

        const gradient = ctx.createLinearGradient(0, 0, 0, 300);
        gradient.addColorStop(0, 'rgba(59, 130, 246, 0.3)');
        gradient.addColorStop(1, 'rgba(59, 130, 246, 0.0)');

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Users',
                    data: dataValues,
                    borderColor: '#3b82f6',
                    backgroundColor: gradient,
                    borderWidth: 2,
                    pointBackgroundColor: '#1e293b',
                    pointBorderColor: '#60a5fa',
                    pointRadius: 4,
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(255, 255, 255, 0.05)' },
                        ticks: { color: '#64748b', font: {family: 'Inter', size: 10} }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { color: '#64748b', font: {family: 'Inter', size: 10} }
                    }
                }
            }
        });

        // --- 📡 SOCKET UPDATES ---
        const socket = io();
        socket.on('update_stats', (data) => {
            document.getElementById('stat-downloads').innerText = data.stats.downloads;
            document.getElementById('stat-active').innerText = data.userList.length;

            const list = document.getElementById('live-user-list');
            if(data.userList.length === 0) {
                list.innerHTML = `<div class="h-full flex flex-col items-center justify-center text-slate-600"><i class="ph-duotone ph-plugs text-3xl mb-2"></i><p class="text-xs">No active sessions</p></div>`;
            } else {
                list.innerHTML = data.userList.map(u => `
                    <div class="flex items-center justify-between p-3 rounded-lg bg-slate-900/50 border border-slate-800/50">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-xs font-bold text-slate-300 border border-slate-700">
                                ${u.name.charAt(0)}
                            </div>
                            <div>
                                <p class="text-xs font-medium text-white">${u.name}</p>
                                <p class="text-[10px] text-slate-500">ID: ...${u.id.toString().slice(-4)}</p>
                            </div>
                        </div>
                        <span class="text-[10px] font-mono text-emerald-500 bg-emerald-500/10 px-2 py-0.5 rounded">ONLINE</span>
                    </div>
                `).join('');
            }
        });

        // --- 🔔 MODAL LOGIC ---
        const modal = document.getElementById('profileModal');
        const backdrop = document.getElementById('modalBackdrop');
        const panel = document.getElementById('modalPanel');

        function toggleModal() {
            const isHidden = modal.classList.contains('hidden');
            
            if (isHidden) {
                // OPEN
                modal.classList.remove('hidden');
                // Small timeout to allow render before transition
                setTimeout(() => {
                    backdrop.classList.remove('opacity-0');
                    panel.classList.remove('opacity-0', 'translate-y-4', 'sm:translate-y-0', 'sm:scale-95');
                    panel.classList.add('opacity-100', 'translate-y-0', 'sm:scale-100');
                }, 10);
            } else {
                // CLOSE
                backdrop.classList.add('opacity-0');
                panel.classList.remove('opacity-100', 'translate-y-0', 'sm:scale-100');
                panel.classList.add('opacity-0', 'translate-y-4', 'sm:translate-y-0', 'sm:scale-95');
                
                setTimeout(() => {
                    modal.classList.add('hidden');
                }, 200);
            }
        }
        
        // Close on backdrop click
        modal.addEventListener('click', (e) => {
            if (e.target === backdrop || e.target.closest('#modalPanel') === null) {
                // Only close if clicking outside panel, but check if we clicked the panel content
                // Actually easier: simply check if target IS backdrop
                if (e.target === modal || e.target === backdrop) {
                   // toggleModal(); // Optional: Auto close on outside click
                }
            }
        });
    </script>
</body>
</html>